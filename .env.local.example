# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API Keys (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# SECRET key (sb_secret_... or the legacy service_role key). Server only:
# never share it and never rename it to NEXT_PUBLIC_...
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Public address of this website (used in WhatsApp order links)
SITE_URL=http://localhost:3000
